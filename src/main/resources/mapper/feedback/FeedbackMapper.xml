<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mailook.feedback.dao.FeedbackDao">

    <resultMap id="feedbackMap" type="Feedback">
        <id property="feedbackId" column="feedback_id"/>
        <result property="userId" column="user_id"/>
        <result property="wearRecordId" column="wear_record_id"/>
        <result property="preference" column="preference"/>
        <result property="sensation" column="sensation"/>
        <result property="memo" column="memo"/>
        <result property="moment" column="moment"/>
        <result property="placeId" column="place_id"/>
        <result property="weatherSnapshotId" column="weather_snapshot_id"/>
        <result property="createdAt" column="created_at"/>
        <collection property="bodyParts" ofType="com.mailook.feedback.enums.BodyPart"
                    column="feedback_id" select="selectBodyParts"/>
        <collection property="weatherFactors" ofType="com.mailook.feedback.enums.WeatherFactor"
                    column="feedback_id" select="selectWeatherFactors"/>
        <collection property="dayContexts" ofType="com.mailook.feedback.enums.DayContext"
                    column="feedback_id" select="selectDayContexts"/>
    </resultMap>

    <sql id="feedbackColumns">
        feedback_id, user_id, wear_record_id, preference, sensation, memo,
        moment, place_id, weather_snapshot_id, created_at
    </sql>

    <insert id="insertFeedback" parameterType="Feedback"
            useGeneratedKeys="true" keyProperty="feedbackId" keyColumn="feedback_id">
        INSERT INTO feedbacks (
            user_id, wear_record_id, preference, sensation, memo,
            moment, place_id, weather_snapshot_id
        ) VALUES (
            #{userId}, #{wearRecordId}, #{preference}, #{sensation}, #{memo},
            #{moment}, #{placeId}, #{weatherSnapshotId}
        )
    </insert>

    <!-- 목록이 비어 있으면 Service에서 호출하지 않는다. -->
    <insert id="insertBodyParts">
        INSERT INTO feedback_body_parts (feedback_id, body_part)
        VALUES
        <foreach collection="bodyParts" item="bodyPart" separator=",">
            (#{feedbackId}, #{bodyPart})
        </foreach>
    </insert>

    <!-- 목록이 비어 있으면 Service에서 호출하지 않는다. -->
    <insert id="insertWeatherFactors">
        INSERT INTO feedback_weather_factors (feedback_id, weather_factor)
        VALUES
        <foreach collection="weatherFactors" item="weatherFactor" separator=",">
            (#{feedbackId}, #{weatherFactor})
        </foreach>
    </insert>

    <!-- 목록이 비어 있으면 Service에서 호출하지 않는다. -->
    <insert id="insertDayContexts">
        INSERT INTO feedback_day_contexts (feedback_id, day_context)
        VALUES
        <foreach collection="dayContexts" item="dayContext" separator=",">
            (#{feedbackId}, #{dayContext})
        </foreach>
    </insert>

    <select id="existsByWearRecordId" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM feedbacks WHERE wear_record_id = #{wearRecordId})
    </select>

    <select id="selectById" resultMap="feedbackMap">
        SELECT <include refid="feedbackColumns"/>
        FROM feedbacks
        WHERE feedback_id = #{feedbackId}
    </select>

    <select id="selectRecentByUser" resultMap="feedbackMap">
        SELECT <include refid="feedbackColumns"/>
        FROM feedbacks
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <select id="selectByUserSince" resultMap="feedbackMap">
        SELECT <include refid="feedbackColumns"/>
        FROM feedbacks
        WHERE user_id = #{userId}
        <if test="since != null">
            AND created_at &gt; #{since}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="selectBodyParts" resultType="com.mailook.feedback.enums.BodyPart">
        SELECT body_part
        FROM feedback_body_parts
        WHERE feedback_id = #{feedbackId}
    </select>

    <select id="selectWeatherFactors" resultType="com.mailook.feedback.enums.WeatherFactor">
        SELECT weather_factor
        FROM feedback_weather_factors
        WHERE feedback_id = #{feedbackId}
    </select>

    <select id="selectDayContexts" resultType="com.mailook.feedback.enums.DayContext">
        SELECT day_context
        FROM feedback_day_contexts
        WHERE feedback_id = #{feedbackId}
    </select>

</mapper>
